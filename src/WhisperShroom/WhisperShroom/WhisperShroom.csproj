<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WhisperShroom</RootNamespace>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Package mode: override with -p:UapAppxPackageBuildMode=StoreUpload for Store submission -->
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <!-- Signing: self-signed for sideload, Microsoft signs Store packages -->
    <AppxPackageSigningEnabled Condition="'$(UapAppxPackageBuildMode)' != 'StoreUpload'">true</AppxPackageSigningEnabled>
    <AppxPackageSigningEnabled Condition="'$(UapAppxPackageBuildMode)' == 'StoreUpload'">false</AppxPackageSigningEnabled>
    <PackageCertificateThumbprint Condition="'$(AppxPackageSigningEnabled)' == 'true' AND '$(PackageCertificateKeyFile)' == ''">4501F2CDFC5B6EFBD5D6D418E4D9AA52CD2C367F</PackageCertificateThumbprint>
    <PackageCertificateKeyFile Condition="'$(AppxPackageSigningEnabled)' == 'true' AND '$(PackageCertificateKeyFile)' != ''">$(PackageCertificateKeyFile)</PackageCertificateKeyFile>
    <GenerateAppxPackageOnBuild Condition="'$(Configuration)'=='Release'">true</GenerateAppxPackageOnBuild>
    <AppxPackageDir>$(MSBuildThisFileDirectory)..\..\..\dist\</AppxPackageDir>
    <AppxBundle>Never</AppxBundle>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!--
      Roslyn embeds the absolute build directory in the assembly (PE debug directory +
      source paths), so the same commit produced different binaries on a dev machine
      (C:\code\...) and on the CI runner (D:\a\...). Mapping the project directory to a
      fixed virtual root makes the compiled output independent of where it was built,
      and keeps local directory layout out of the shipped package.
      Trade-off: stack traces report /_/Views/MainWindow.xaml.cs instead of an absolute
      path. File name and line number are unaffected.
    -->
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <!--
      Every PackageReference below floats (0.3.*, 2.6.* ...), so two machines could
      resolve different versions of the same declared dependency. That is not only a
      reproducibility problem: CsWin32 is a source generator, and CI shipped code
      generated by 0.3.298 while local builds had tested 0.3.275. The lock file records
      the resolved graph including transitive packages; CI restores in locked mode so a
      drifting version fails the build instead of silently shipping.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\icon.ico" />
    <Content Include="Assets\icon-recording.ico" />
    <Content Include="Assets\icon-transcribing.ico" />
  </ItemGroup>

  <!--
    The Windows App SDK packaging targets locate mspdbcmf.exe, which builds the symbol
    package, through $(VsInstallRoot) or $(VCToolsInstallDir). Neither is set when
    building with `dotnet build` outside a Developer Command Prompt, so every Release
    build warned and silently skipped the symbol package, on this machine and on the CI
    runner alike, even though the tool was installed in both cases.

    vswhere is placed at a fixed location by the VS Installer, so resolving the install
    root from it works in both environments. Only VsInstallRoot is set; the SDK's own
    logic then picks the MSVC version and host architecture. If Visual Studio or the C++
    tools are absent, the property stays empty and the SDK falls back to its previous
    behaviour, warning included.
  -->
  <Target Name="ResolveVsInstallRootForSymbolPackage"
          BeforeTargets="_EnsurePdbCmfExeFullPath"
          Condition="'$(VsInstallRoot)' == '' and '$(VCToolsInstallDir)' == '' and '$(MsPdbCmfExeFullpath)' == ''">
    <PropertyGroup>
      <_VsWhereExe>$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer\vswhere.exe</_VsWhereExe>
    </PropertyGroup>
    <Exec Condition="Exists('$(_VsWhereExe)')"
          Command="&quot;$(_VsWhereExe)&quot; -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_ResolvedVsInstallRoot" />
    </Exec>
    <PropertyGroup Condition="'$(_ResolvedVsInstallRoot)' != '' and Exists('$(_ResolvedVsInstallRoot)')">
      <VsInstallRoot>$(_ResolvedVsInstallRoot)</VsInstallRoot>
    </PropertyGroup>
    <Message Importance="normal" Text="Symbol package: using VsInstallRoot=$(VsInstallRoot)" Condition="'$(VsInstallRoot)' != ''" />
  </Target>

  <!-- Copy .msix to dist/ root after Release build -->
  <Target Name="CopyMsixToDistRoot" AfterTargets="Build" Condition="'$(Configuration)'=='Release' AND '$(GenerateAppxPackageOnBuild)'=='true'">
    <ItemGroup>
      <MsixFiles Include="$(AppxPackageDir)**\WhisperShroom_*.msix" />
    </ItemGroup>
    <Copy SourceFiles="@(MsixFiles)" DestinationFolder="$(AppxPackageDir)" />
  </Target>

  <ItemGroup>
    <!--
      Windows App SDK component packages instead of the Microsoft.WindowsAppSDK metapackage.
      Since 2.x the metapackage also pulls Windows ML, Windows AI, Search and Widgets, which
      ships onnxruntime.dll and DirectML.dll for every architecture inside the MSIX (29 MB to
      82 MB) although the app uses none of it. WinUI brings InteractiveExperiences (windowing)
      transitively, Foundation covers AppLifecycle and AppNotifications, and Runtime keeps the
      framework-dependent deployment on Microsoft.WindowsAppRuntime.2 instead of the
      self-contained default of component-only references.
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.*" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.6.*" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NAudio" Version="2.*" />
    <!--
      2.5 prerelease: the stable 2.4.x line depends on the Microsoft.WindowsAppSDK 1.6
      metapackage, which collides with the 2.x component packages above. 2.5 depends on
      Microsoft.WindowsAppSDK.WinUI only. Move back to a stable range once 2.5 ships.
    -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.5.0-beta.*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.*" />
  </ItemGroup>
</Project>
